{
  "name": "luck-resume",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "resume.lunelu.com", "custom_domain": true }],
  "vars": {
    "LUCK_PUBLIC_ORIGIN": "https://resume.lunelu.com",
    "LUCK_TUNNEL_ORIGIN": "https://resume-api.lunelu.com",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application",
  },
}
